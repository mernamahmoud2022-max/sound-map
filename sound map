<script>
const governoratesData = {
  alexandria: {
    name_en: "Alexandria",
    name_ar: "الإسكندرية",
    description: "مدينة ساحلية مرتبطة بأغاني البحر والحنين.",
    songs: [
      {
        title: "إسكندرية بحري",
        artist: "محمد منير",
        year: "1989",
        url: "https://www.youtube.com/embed/0q6yphdZhUA"
      },
      {
        title: "يا إسكندرية",
