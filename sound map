    name_ar: "سيناء",
    description: "أغاني وطنية.",
    songs: [
      {
        title: "سينا رجعت كاملة لينا",
        artist: "مجموعة فنانين",
        year: "1982",
        url: "https://www.youtube.com/embed/d0gX6FQvW3E"
      }
    ]
  }
};


// ربط المحافظات
const govElements = document.querySelectorAll('.gov.featured');
const panelContent = document.querySelector('.panel-content');
const placeholder = document.querySelector('.panel-placeholder');
const playerBar = document.querySelector('.player-bar');

govElements.forEach(gov => {
  gov.addEventListener('click', () => {
    const govKey = gov.getAttribute('data-gov');
    const data = governoratesData[govKey];
    if (!data) return;

    govElements.forEach(g => g.classList.remove('active'));
    gov.classList.add('active');

    placeholder.style.display = "none";
    panelContent.classList.add('visible');

    panelContent.innerHTML = `
      <div class="gov-header">
        <div class="gov-name-en">${data.name_en}</div>
        <div class="gov-name-ar">${data.name_ar}</div>
        <div class="gov-desc">${data.description}</div>
      </div>

      <div class="section-label">Songs</div>

      ${data.songs.map(song => `
        <div class="song-card">
          <div class="play-btn">▶</div>
          <div class="song-info">
            <div class="song-title">${song.title}</div>
            <div class="song-artist">${song.artist}</div>
          </div>
          <div class="song-year">${song.year}</div>
        </div>
      `).join("")}
    `;

    playSong(data.songs[0]);

    document.querySelectorAll('.song-card').forEach((card, i) => {
      card.addEventListener('click', () => {
        playSong(data.songs[i]);
      });
    });
  });
});


function playSong(song) {
  playerBar.innerHTML = `
    <iframe width="100%" height="180"
      src="${song.url}?autoplay=1"
      frameborder="0"
      allow="autoplay"
      allowfullscreen>
    </iframe>
  `;
  playerBar.classList.add('visible');
}
</script>
