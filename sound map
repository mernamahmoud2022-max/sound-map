      }
    ]
  },

  cairo: {
    name_en: "Cairo",
    name_ar: "القاهرة",
    description: "العاصمة وأغانيها الكلاسيك.",
    songs: [
      {
        title: "في القاهرة",
        artist: "كايروكي",
        year: "2014",
        url: "https://www.youtube.com/embed/6dC4dK1kq9w"
      }
    ]
  },

  aswan: {
    name_en: "Aswan",
    name_ar: "أسوان",
    description: "موسيقى نوبية.",
    songs: [
      {
        title: "أسوان",
        artist: "محمد منير",
        year: "1990s",
        url: "https://www.youtube.com/embed/3vVxZ7Yz0kA"
      }
    ]
  },

  luxor: {
    name_en: "Luxor",
    name_ar: "الأقصر",
    description: "تراث صعيدي.",
    songs: [
      {
        title: "الأقصر بلدنا",
        artist: "تراث",
        year: "تراث",
        url: "https://www.youtube.com/embed/8cK6Fh9wX8Q"
      }
    ]
  },

  portsaid: {
    name_en: "Port Said",
    name_ar: "بورسعيد",
    description: "مدينة القناة.",
    songs: [
      {
